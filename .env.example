# Copier ce fichier en ".env" et adapter les valeurs avant le premier démarrage.

PORT=4000

# Secret utilisé pour signer les jetons JWT (staff + espace client).
# Générer une valeur aléatoire forte, ex: openssl rand -hex 32
JWT_SECRET=change-moi-en-une-valeur-secrete-longue

# Fichier de base de données SQLite (créé automatiquement au premier démarrage).
DB_FILE=./data/tracalinge.db

# Origines autorisées à appeler l'API (front-end web, séparées par des virgules).
CORS_ORIGINS=http://localhost:5173

# Compte administrateur créé automatiquement au premier démarrage (npm run seed).
ADMIN_EMAIL=admin@tracalinge.fr
ADMIN_PASSWORD=change-moi

# Clé d'accès partagée pour les appareils de collecte (antennes fixes, PDA mobiles,
# terminaux de livraison). Chaque appareil doit envoyer ce header :
#   X-Device-Key: <valeur>
# En production, préférer une clé distincte par appareil (voir README, section "Appareils").
DEVICE_KEY=change-moi-cle-appareils
